# A normal interactive Bash environment, not a command allow-list.
export TERM=xterm-256color
export EDITOR=vim
export KUBE_EDITOR=vim
export HISTCONTROL=ignoredups
export HISTSIZE=10000
export HISTFILESIZE=20000
shopt -s histappend checkwinsize
alias k=kubectl
alias ll='ls -alF'
export do='--dry-run=client -o yaml'
if [ -r /usr/share/bash-completion/bash_completion ]; then
  source /usr/share/bash-completion/bash_completion
fi
stty -ixon 2>/dev/null || true
if command -v kubectl >/dev/null 2>&1; then
  source <(kubectl completion bash 2>/dev/null)
  complete -o default -F __start_kubectl k
fi
if [ ! -f "$HOME/.vimrc" ]; then
  printf 'set number\nset tabstop=2\nset shiftwidth=2\nset expandtab\nset autoindent\nset backspace=indent,eol,start\n' > "$HOME/.vimrc"
fi
_ckad_prompt() {
  history -a
  local namespace
  namespace=$(kubectl config view --minify -o 'jsonpath={..namespace}' 2>/dev/null)
  namespace=${namespace//[^a-z0-9-]/}
  PS1="\[\e[38;5;81m\]${namespace:-default}\[\e[0m\]:\[\e[38;5;114m\]\w\[\e[0m\] \\$ "
}
PROMPT_COMMAND=_ckad_prompt
printf '\n'
