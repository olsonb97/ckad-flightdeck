# Track only distributable source; local credentials, state and archives stay out.
**
!.gitignore
!.gitattributes
!.dockerignore
!.env.example
!Dockerfile
!LICENSE
!README.md
!compose.yaml
!requirements.txt
!start.cmd
!start.ps1
!start.sh
!app/
!app/*.py
!app/shellrc
!app/static/
!app/static/*.js
!app/static/*.css
!app/static/*.html
!app/static/vendor/
!app/static/vendor/*.js
!app/static/vendor/*.css
!app/static/vendor/*.txt
!docs/
!docs/QUESTION_CATALOG.md
!docs/SOURCES.md
!scripts/
!scripts/package.py
!scripts/migrate-identities.ps1
!scripts/migrate-identities.sh
!scripts/diagnostics.sh
!scripts/browser_smoke.py
!scripts/tutor_browser_smoke.py
!tests/
!tests/test_*.py
